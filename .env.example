# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.

# --- Database ---------------------------------------------------------------
# MySQL connection string. Without it the app still boots, but registration
# returns "temporarily unavailable" (see server/db.ts).
DATABASE_URL=mysql://user:password@host:3306/hopealive

# --- Email delivery (Resend) ------------------------------------------------
# Server-only. These are never sent to the browser (see server/_core/publicConfig.ts).
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend, otherwise sends
# are rejected. Display-name form is supported:
#   RESEND_FROM_EMAIL=Hope-Alive IVC <ivc@your-verified-domain.org>
RESEND_FROM_EMAIL=
# Optional. Reply-To shown to recipients — use a monitored inbox.
RESEND_REPLY_TO=
# Public base URL, used to build links inside emails. No trailing slash.
APP_URL=http://localhost:3000

# --- Receipt verification (Claude) ------------------------------------------
# Server-only. After paying, a registrant uploads a screenshot of their bank
# receipt on the site; Claude reads it and checks it against the Hope-Alive
# account details. Without a key, receipts are still saved and queued for
# manual admin review — nothing is lost.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5.
RECEIPT_VERIFICATION_MODEL=
# Expected registration fee in naira, digits only (e.g. 5000). When unset the
# amount cannot be checked, so every receipt is routed to admin review.
REGISTRATION_FEE_NGN=
# WhatsApp group invite link. Revealed ONLY to registrations whose payment has
# been verified. It is never sent to the browser for anyone else.
WHATSAPP_GROUP_URL=

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Manus platform (OAuth, storage, notifications) -------------------------
# Supplied by the platform in a managed deployment. Admin sign-in at /admin
# depends on these; leave blank for local development without login.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
MANUS_API_URL=
MANUS_API_KEY=
MANUS_API_BROWSER_KEY=
# OpenID of the account that should be granted the `admin` role on first login.
OWNER_OPEN_ID=
