# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.

# --- Database ---------------------------------------------------------------
# MySQL connection string. Without it the app still boots, but registration
# returns "temporarily unavailable" (see server/db.ts).
DATABASE_URL=mysql://user:password@host:3306/hopealive

# --- Email delivery (Resend) ------------------------------------------------
# Server-only. These are never sent to the browser (see server/_core/publicConfig.ts).
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend, otherwise sends
# are rejected. Display-name form is supported:
#   RESEND_FROM_EMAIL=Hope-Alive IVC <ivc@your-verified-domain.org>
RESEND_FROM_EMAIL=
# Optional. Reply-To shown to recipients — use a monitored inbox.
RESEND_REPLY_TO=
# Public base URL, used to build links inside emails. No trailing slash.
APP_URL=http://localhost:3000

# --- Payment / registration -------------------------------------------------
# Registration fee in naira, digits only (e.g. 5000). Shown to users on the
# payment page. Leave blank to show "to be confirmed" instead of an amount.
REGISTRATION_FEE_NGN=
# WhatsApp group invite link. Revealed ONLY to registrations an admin has
# confirmed. It is never sent to the browser for anyone else.
WHATSAPP_GROUP_URL=

# --- Admin login (email + password) -----------------------------------------
# The single administrator sign-in for /admin. Credentials are compared on the
# server and never exposed to the browser. Set a long random ADMIN_SESSION_SECRET
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# used to sign the admin session cookie; rotating it signs everyone out.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Manus platform (OAuth, storage, notifications) -------------------------
# Supplied by the platform in a managed deployment. Admin sign-in at /admin
# depends on these; leave blank for local development without login.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
MANUS_API_URL=
MANUS_API_KEY=
MANUS_API_BROWSER_KEY=
# OpenID of the account that should be granted the `admin` role on first login.
OWNER_OPEN_ID=
