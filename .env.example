# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. Without it the app still boots, but registration
# returns "temporarily unavailable" (see server/db.ts).
DATABASE_URL=

# --- Optional email delivery -------------------------------------------------
# Email delivery is not required for registration to work. Leave these unset to
# keep the website fully functional while avoiding any third-party mail setup.
# If enabled later, configure them privately in a local `.env` file and never
# commit the real values to the repository.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
APP_URL=http://localhost:3000

# --- Payment / registration -------------------------------------------------
# Registration fee in naira, digits only (e.g. 5000). Shown to users on the
# payment page. Leave blank to show "to be confirmed" instead of an amount.
REGISTRATION_FEE_NGN=
# WhatsApp group invite link. Revealed ONLY to registrations an admin has
# confirmed. It is never sent to the browser for anyone else.
WHATSAPP_GROUP_URL=

# --- Admin login (email + password) -----------------------------------------
# Super-admin credentials have full access. Credentials are compared on the
# server and never exposed to the browser. Set a long random ADMIN_SESSION_SECRET
# (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# used to sign the admin session cookie; rotating it signs everyone out.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional limited access: view participants, verify/reject payments, and check in.
SUB_ADMIN_EMAIL=team@hopealive
SUB_ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
